# Reconstruction Worker Configuration

# Main Application Server URL
SERVER_URL=http://localhost:3000

# Worker Authentication Secret (must match RECONSTRUCTION_WORKER_SECRET on server)
WORKER_SECRET=dev-worker-secret-key-2026

# Worker ID
WORKER_ID=gpu-worker-local-01

# Poll Interval in Seconds
POLL_INTERVAL_SECONDS=5

# Dry Run Mode ($0 Testing - No CUDA/GPU required)
DRY_RUN=true

# GPU Device ID (for real execution)
CUDA_VISIBLE_DEVICES=0
