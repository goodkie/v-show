{
  "manifest_version": 3,
  "name": "Runtime Inspector (RI)",
  "version": "1.1.0",
  "description": "Universal Browser & Web Application Runtime Diagnostics Platform",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation"
  ],
  "optional_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://v-show-commercial-v1-production.up.railway.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Runtime Inspector"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js",
        "core/*",
        "adapters/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
