{
  "manifest_version": 3,
  "name": "XPIDER AutoForm Sender Pro",
  "version": "1.2.0",
  "key": "",
  "description": "웹사이트의 문의 양식(Contact Form)을 자동으로 감지하고 메시지를 대량 발송하는 강력한 폼 마케팅 엔진입니다.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "sidePanel",
    "alarms",
    "downloads",
    "debugger",
    "privacy",
    "proxy",
    "webRequest",
    "webRequestAuthProvider",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/recaptcha/*",
        "*://*.google.co.kr/recaptcha/*",
        "*://*.recaptcha.net/*",
        "*://*.hcaptcha.com/*",
        "*://*.cloudflare.com/turnstile/*",
        "*://challenges.cloudflare.com/*",
        "*://*.google.com/sorry/*",
        "*://*.google.co.kr/sorry/*"
      ],
      "js": [
        "solver-content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
