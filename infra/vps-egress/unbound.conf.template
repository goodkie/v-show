# Unbound Recursive DNS Resolver Configuration Template
# Listens strictly on VPN internal addresses (Issue #6 R6.9G.10.3.7)

server:
    verbosity: 1
    interface: 127.0.0.1
    interface: 10.66.66.1
    interface: 10.67.67.1
    port: 53
    do-ip4: yes
    do-ip6: no
    do-udp: yes
    do-tcp: yes

    # Access control: strictly allow VPN subnets and localhost only
    access-control: 127.0.0.0/8 allow
    access-control: 10.66.66.0/24 allow
    access-control: 10.67.67.0/24 allow
    access-control: 0.0.0.0/0 refuse

    hide-identity: yes
    hide-version: yes
    harden-glue: yes
    harden-dnssec-stripped: yes
    use-caps-for-id: yes
    cache-min-ttl: 3600
    cache-max-ttl: 86400
    prefetch: yes

forward-zone:
    name: "."
    forward-addr: 1.1.1.1
    forward-addr: 9.9.9.9
